{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:transvortex:agent-setup-contract:2",
  "title": "TransVortex Agent setup contract",
  "description": "Versioned, secret-free payload emitted by TransVortex setup-plan/setup-verify and the compatible plan envelope an Agent may produce.",
  "type": "object",
  "required": ["schema_version", "contract", "kind"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "contract": {"type": "string", "const": "transvortex.agent_setup"},
    "kind": {"type": "string", "enum": ["setup_plan", "setup_verify", "managed_apply", "model_probe", "model_register", "accelerator_probe", "accelerator_register", "resources_activate", "provider_test", "agent_plan", "agent_result"]},
    "ok": {"type": "boolean", "description": "For setup_plan, the contract was generated; for setup_verify/provider_test, the verification or probe succeeded."},
    "ready": {"type": "boolean", "description": "Whether a generated setup_plan has no blocking items and is ready for use."},
    "asr_ready": {"type": "boolean", "description": "Current active ASR readiness in setup_plan; the verified complete readiness result in setup_verify, independent of requested scope completion."},
    "requested_scope": {"$ref": "#/$defs/setup_scope"},
    "scope_policy": {"$ref": "#/$defs/scope_policy"},
    "scope_result": {"$ref": "#/$defs/scope_result"},
    "network_access": {"type": "boolean"},
    "plan_status": {"type": "string", "enum": ["ready", "needs_action", "blocked"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": "string", "format": "date-time"},
    "product": {"$ref": "#/$defs/product"},
    "platform": {"$ref": "#/$defs/platform"},
    "storage": {"$ref": "#/$defs/storage"},
    "root_dir": {"type": "string"},
    "providers_file": {"type": "string"},
    "active_asr": {"oneOf": [{"$ref": "#/$defs/asr"}, {"type": "null"}]},
    "current_configuration": {"oneOf": [{"$ref": "#/$defs/asr"}, {"type": "null"}]},
    "execution_resolution": {"type": "object", "additionalProperties": true},
    "current": {"$ref": "#/$defs/current"},
    "requirements": {"$ref": "#/$defs/requirements"},
    "selection": {"$ref": "#/$defs/selection"},
    "resources": {"$ref": "#/$defs/resources"},
    "allowed_actions": {"type": "array", "items": {"type": "string"}},
    "forbidden_actions": {"type": "array", "items": {"type": "string"}},
    "blocking_items": {"type": "array", "items": {"$ref": "#/$defs/blocking_item"}},
    "success_conditions": {"type": "array", "items": {"type": "string"}},
    "verification": {"$ref": "#/$defs/verification"},
    "executes_local_code": {"type": "boolean"},
    "asr_verification_performed": {"type": "boolean"},
    "verification_profile": {"type": "string", "enum": ["scope_only", "full"]},
    "executor": {"type": "string", "enum": ["transvortex", "agent"]},
    "ownership": {"type": "string", "enum": ["transvortex", "external", "system"]},
    "resource": {"type": "string"},
    "operation": {"type": ["object", "string", "null"], "additionalProperties": true},
    "agent_commands": {"type": "object", "additionalProperties": {"type": "string"}},
    "agent_argv": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "config_error": {"type": "string"},
    "catalog_error": {"type": "string"},
    "readiness_error": {"type": "string"},
    "environment_error": {"type": "string"},
    "readiness": {"$ref": "#/$defs/readiness"},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "integrity": {"$ref": "#/$defs/integrity"},
    "read_only": {"type": "boolean"},
    "status": {"type": "string", "enum": ["ready", "needs_user", "blocked", "failed"]},
    "provider_mode": {"oneOf": [{"type": "string", "enum": ["local_worker", "local_service", "remote_provider"]}, {"type": "null"}]},
    "alternatives": {"type": "array", "items": {"$ref": "#/$defs/alternative"}},
    "plan_id": {"type": "string"},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action_result"}},
    "next": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "host": {"$ref": "#/$defs/host"},
    "current_state": {"type": "object", "additionalProperties": true},
    "requested": {"$ref": "#/$defs/requested"},
    "policy": {"$ref": "#/$defs/policy"},
    "plan": {"$ref": "#/$defs/plan"},
    "result": {"$ref": "#/$defs/result"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "setup_plan"}}, "required": ["kind"]},
      "then": {
        "required": [
          "ok",
          "ready",
          "asr_ready",
          "requested_scope",
          "scope_policy",
          "scope_result",
          "plan_status",
          "product",
          "platform",
          "storage",
          "root_dir",
          "active_asr",
          "current_configuration",
          "provider_mode",
          "alternatives",
          "plan_id",
          "plan",
          "current",
          "requirements",
          "selection",
          "resources",
          "allowed_actions",
          "forbidden_actions",
          "blocking_items",
          "success_conditions",
          "verification",
          "read_only",
          "network_access"
        ]
      }
    },
    {
      "if": {"properties": {"kind": {"const": "setup_verify"}}, "required": ["kind"]},
      "then": {
        "required": [
          "ok",
          "asr_ready",
          "requested_scope",
          "scope_policy",
          "scope_result",
          "root_dir",
          "active_asr",
          "readiness",
          "checks",
          "blocking_items",
          "success_conditions",
          "read_only",
          "network_access"
        ]
      }
    },
    {
      "if": {"properties": {"kind": {"const": "provider_test"}}, "required": ["kind"]},
      "then": {
        "required": ["ok", "status", "code", "provider", "probe", "network_access", "read_only"],
        "properties": {
          "status": {"enum": ["ready", "needs_user", "failed"]},
          "provider": {"oneOf": [{"$ref": "#/$defs/asr"}, {"type": "string"}]},
          "probe": {"type": "object", "additionalProperties": true}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "agent_result"}}, "required": ["kind"]},
      "then": {
        "required": ["status", "provider_mode", "actions", "verification", "next", "errors"]
      }
    },
    {
      "if": {"properties": {"kind": {"const": "agent_plan"}}, "required": ["kind"]},
      "then": {
        "required": ["plan", "requested", "policy", "alternatives"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {"const": "agent_result"},
          "status": {"const": "ready"}
        },
        "required": ["kind", "status"]
      },
      "then": {
        "properties": {
          "provider_mode": {"not": {"type": "null"}},
          "verification": {
            "required": ["readiness", "probe"],
            "properties": {
              "readiness": {"const": "pass"},
              "probe": {"const": "pass"}
            }
          },
          "actions": {
            "not": {
              "contains": {
                "properties": {"status": {"enum": ["failed", "blocked"]}},
                "required": ["status"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"kind": {"const": "setup_plan"}, "ready": {"const": true}},
        "required": ["kind", "ready"]
      },
      "then": {
        "properties": {
          "plan_status": {"const": "ready"},
          "blocking_items": {
            "not": {
              "contains": {
                "properties": {"severity": {"const": "blocking"}},
                "required": ["severity"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {"const": "setup_verify"},
          "ok": {"const": true}
        },
        "required": ["kind", "ok"]
      },
      "then": {
        "properties": {
          "readiness": {
            "required": ["can_run"],
            "properties": {"can_run": {"const": true}}
          },
          "checks": {
            "items": {
              "properties": {"status": {"enum": ["pass", "skip"]}},
              "required": ["status"]
            }
          },
          "blocking_items": {
            "not": {
              "contains": {
                "properties": {"severity": {"const": "blocking"}},
                "required": ["severity"]
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "setup_scope": {
      "type": "string",
      "enum": ["inspect", "prepare_model", "prepare_accelerator", "register", "full"]
    },
    "scope_policy": {
      "type": "object",
      "required": ["requested_scope", "selection_authority", "current_configuration_role", "permitted_mutations", "completion_conditions", "result_destination"],
      "properties": {
        "requested_scope": {"$ref": "#/$defs/setup_scope"},
        "selection_authority": {"type": "string", "const": "agent"},
        "current_configuration_role": {"type": "string", "const": "inspection_baseline"},
        "current_configuration_is_target": {"type": "boolean", "const": false},
        "mutation_policy": {"type": "string", "enum": ["forbidden", "limited_to_scope"]},
        "permitted_mutations": {"type": "array", "items": {"type": "string"}},
        "permitted_resources": {"type": "array", "items": {"type": "string"}},
        "completion_conditions": {"type": "array", "items": {"type": "string"}},
        "additional_confirmation_required_for": {"type": "array", "items": {"type": "string"}},
        "result_destination": {"type": "string", "const": "agent_conversation"}
      },
      "additionalProperties": true
    },
    "scope_result": {
      "type": "object",
      "required": ["requested_scope", "status", "complete", "asr_ready", "basis", "criteria"],
      "properties": {
        "requested_scope": {"$ref": "#/$defs/setup_scope"},
        "status": {"type": "string", "enum": ["complete", "needs_action", "blocked"]},
        "complete": {"type": "boolean"},
        "asr_ready": {"type": "boolean"},
        "basis": {"type": "string"},
        "verification_performed": {"type": "boolean"},
        "provisional": {"type": "boolean"},
        "agent_report_required": {"type": "boolean"},
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": {"type": "string"},
              "status": {"type": "string", "enum": ["pass", "fail", "pending"]}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "product": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "const": "transvortex"},
        "version": {"type": "string"},
        "cli_executable": {"type": "string"},
        "installation_root": {"type": "string"},
        "data_root": {"type": "string"},
        "capabilities": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "platform": {
      "type": "object",
      "properties": {
        "system": {"type": "string"},
        "release": {"type": "string"},
        "machine": {"type": "string"},
        "python_version": {"type": "string"},
        "python_executable": {"type": "string"},
        "disk": {
          "type": "object",
          "properties": {
            "free_bytes": {"type": ["integer", "null"], "minimum": 0},
            "total_bytes": {"type": ["integer", "null"], "minimum": 0}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "storage": {
      "type": "object",
      "properties": {
        "root": {"type": "string"},
        "disk_root": {"type": "string"},
        "selection_origin": {"type": "string", "enum": ["configured", "fallback", "unknown"]},
        "total_bytes": {"type": "integer", "minimum": 0},
        "free_bytes": {"type": "integer", "minimum": 0},
        "reserve_bytes": {"type": "integer", "minimum": 0},
        "space_known": {"type": "boolean"},
        "writable": {"type": "boolean"},
        "can_change": {"type": "boolean"},
        "change_blocker": {"type": "string"},
        "config_valid": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "host": {
      "type": "object",
      "properties": {
        "os": {"type": "string"},
        "os_version": {"type": "string"},
        "architecture": {"type": "string"},
        "admin": {"type": "boolean"},
        "reboot_pending": {"type": "boolean"},
        "disk_free_bytes": {"type": "integer", "minimum": 0},
        "gpu": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      },
      "additionalProperties": true
    },
    "asr": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "kind": {"type": "string"},
        "protocol": {"type": "string"},
        "model": {"type": "string"},
        "runtime_source": {"type": "string"},
        "runtime_id": {"type": "string"},
        "accelerator_source": {"type": "string", "enum": ["managed", "external", ""]},
        "accelerator_id": {"type": "string"},
        "model_source": {"type": "string"},
        "model_path_configured": {"type": "boolean"},
        "device": {"type": "string"},
        "compute_type": {"type": "string"},
        "auth_type": {"type": "string"},
        "env_key": {"type": "string"},
        "credential_id": {"type": "string"},
        "credential_required": {"type": "boolean"},
        "credential_configured": {"type": "boolean"},
        "credential_metadata_valid": {"type": "boolean"},
        "base_url": {"type": "string"},
        "endpoint": {"type": "string"},
        "network_scope": {"type": "string", "enum": ["loopback", "remote", "invalid"]},
        "configured_preferences": {"type": "object", "additionalProperties": true},
        "execution": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "readiness": {
      "type": "object",
      "properties": {
        "state": {"type": "string"},
        "code": {"type": "string"},
        "can_run": {"type": "boolean"},
        "primary_action": {"type": "string"},
        "checked_at": {"type": "string"},
        "details": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "current": {
      "type": "object",
      "properties": {
        "readiness": {"$ref": "#/$defs/readiness"},
        "paths": {"type": "object", "additionalProperties": {"type": "string"}},
        "storage": {"$ref": "#/$defs/storage"},
        "runtime": {"type": "object", "additionalProperties": true},
        "accelerators": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "models": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "registered_models": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "registered_accelerators": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "environment_candidates": {"type": "array", "items": {"$ref": "#/$defs/environment"}},
        "provider_test": {"oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]}
      },
      "additionalProperties": true
    },
    "requirements": {
      "type": "object",
      "properties": {
        "binding_role": {"type": "string", "const": "current_configuration_only"},
        "target_locked": {"type": "boolean", "const": false},
        "runtime": {"oneOf": [{"$ref": "#/$defs/requirement"}, {"type": "null"}]},
        "managed_runtime": {"$ref": "#/$defs/requirement"},
        "accelerator": {"oneOf": [{"$ref": "#/$defs/requirement"}, {"type": "null"}]},
        "available_accelerators": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
        "model": {"oneOf": [{"$ref": "#/$defs/model_requirement"}, {"type": "null"}]},
        "available_models": {"type": "array", "items": {"$ref": "#/$defs/model_requirement"}}
      },
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "properties": {
        "runtime": {"$ref": "#/$defs/resource"},
        "model": {"$ref": "#/$defs/resource"},
        "accelerator": {"$ref": "#/$defs/resource"},
        "driver": {"$ref": "#/$defs/resource"},
        "configuration": {"$ref": "#/$defs/resource"},
        "provider": {"$ref": "#/$defs/resource"}
      },
      "additionalProperties": true
    },
    "selection": {
      "type": "object",
      "required": ["authority", "target_locked", "current_configuration_is_target", "decision_timing", "device_options", "scope"],
      "properties": {
        "authority": {"type": "string", "const": "agent"},
        "target_locked": {"type": "boolean", "const": false},
        "current_configuration_is_target": {"type": "boolean", "const": false},
        "decision_timing": {"type": "string", "const": "after_host_inspection"},
        "model_candidates": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "registered_model_candidates": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "accelerator_candidates": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "registered_accelerator_candidates": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "model_source_options": {"type": "array", "items": {"type": "string"}},
        "accelerator_source_options": {"type": "array", "items": {"type": "string"}},
        "device_options": {"type": "array", "items": {"type": "string", "enum": ["cpu", "cuda", "auto"]}},
        "scope": {"$ref": "#/$defs/setup_scope"}
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "properties": {
        "source": {"type": "string"},
        "selected_id": {"type": "string"},
        "registration_id": {"type": "string"},
        "configured": {"type": "boolean"},
        "available": {"type": "boolean"},
        "active": {"type": "boolean"},
        "availability_state": {"type": "string"},
        "activation_state": {"type": "string"},
        "ownership": {"type": "string", "enum": ["transvortex", "external", "system"]},
        "executor": {"type": "string", "enum": ["transvortex", "agent"]},
        "prepare_executor": {"type": "string", "enum": ["transvortex", "agent"]},
        "state": {"type": "string"},
        "operations": {"type": "array", "items": {"type": "string"}},
        "supported_sources": {"type": "array", "items": {"type": "string", "enum": ["managed", "external", "system"]}},
        "source_options": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      },
      "additionalProperties": true
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "platform": {"type": "string"},
        "protocol_version": {"type": "integer"},
        "python_version": {"type": "string"},
        "faster_whisper_version": {"type": "string"},
        "ctranslate2_version": {"type": "string"},
        "packages": {"type": "object", "additionalProperties": {"type": "string"}},
        "artifact": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": true
    },
    "model_requirement": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "display_name": {"type": "string"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"},
        "revision": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "size": {"type": "integer", "minimum": 0},
        "files": {"type": "array", "items": {"$ref": "#/$defs/artifact_file"}}
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "properties": {
        "published": {"type": "boolean"},
        "release_tag": {"type": "string"},
        "asset_name": {"type": "string"},
        "url": {"type": "string", "pattern": "^$|^https://[^@/?#]+(?::[0-9]+)?(?:/[^?#]*)?$"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$|^$"}
      },
      "additionalProperties": true
    },
    "artifact_file": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$|^$"}
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "source": {"type": "string"},
        "python_executable": {"type": "string"},
        "python_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$|^$"},
        "python_version": {"type": "string"},
        "faster_whisper_version": {"type": "string"},
        "ctranslate2_version": {"type": "string"},
        "probe": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "requested": {
      "type": "object",
      "properties": {
        "provider_mode": {"type": "string", "enum": ["local_worker", "local_service", "remote_provider", "auto"]},
        "model_id": {"type": "string"},
        "model_revision": {"type": "string"},
        "device": {"type": "string", "enum": ["auto", "cuda", "cpu"]},
        "compute_type": {"type": "string"},
        "source_language": {"type": "string"}
      },
      "additionalProperties": true
    },
    "alternative": {
      "type": "object",
      "required": ["provider_mode", "rank", "reason"],
      "properties": {
        "provider_mode": {"type": "string", "enum": ["local_worker", "local_service", "remote_provider"]},
        "rank": {"type": "integer", "minimum": 1},
        "reason": {"type": "string"},
        "observed": {"type": "boolean"},
        "availability": {"type": "string", "enum": ["observed", "detected_candidate"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "blocking": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "properties": {
        "allowed_actions": {"type": "array", "items": {"type": "string"}},
        "forbidden_actions": {"type": "array", "items": {"type": "string"}},
        "approval_required_for": {"type": "array", "items": {"type": "string"}},
        "allowed_output_root": {"type": "string"},
        "network": {"type": "string", "enum": ["offline", "trusted_manifest_only", "user_approved"]}
      },
      "additionalProperties": true
    },
    "plan": {
      "type": "object",
      "required": ["plan_id", "created_at", "provider_mode", "actions", "rollback"],
      "properties": {
        "plan_id": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "provider_mode": {"oneOf": [{"type": "string", "enum": ["local_worker", "local_service", "remote_provider"]}, {"type": "null"}]},
        "requested_scope": {"$ref": "#/$defs/setup_scope"},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "rollback": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "mutating",
        "requires_confirmation",
        "requires_admin",
        "requires_restart",
        "requires_network",
        "may_cost_money",
        "expected_outputs",
        "rollback"
      ],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "resource": {"type": "string", "enum": ["environment", "runtime", "model", "accelerator", "driver", "configuration", "provider"]},
        "operation": {"type": "string", "enum": ["inspect", "prepare", "apply", "register", "activate", "verify"]},
        "executor": {"type": "string", "enum": ["transvortex", "agent"]},
        "ownership": {"type": "string", "enum": ["transvortex", "external", "system", "none"]},
        "description": {"type": "string"},
        "role": {"type": "string", "enum": ["required", "dependency", "candidate", "completion"]},
